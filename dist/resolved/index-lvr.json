{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schema for InGrid Index \"LVR\"",
  "type": "object",
  "allOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "title": "Root fields",
      "properties": {
        "id": {
          "type": "string",
          "description": "The ID of the Dataset. The ID **must** be unique in the index.\n",
          "examples": [
            "Für UMWELTNAVI <oid>-<part> i.e. 'nlwkn-dsk-4922-21000-0'",
            "For InGrid Editor i.e. 'd43dad1f-a19f-4043-bca4-447cf5e7cabb'"
          ]
        },
        "schema_version": {
          "type": "string",
          "description": "Die Version des Schemas des Indexes. \nDie Version richtet sich nach der Versionierung des InGrid Releases. \nSemantic Versioning soll verwendet werden.\nZusätzlich kann eine Schema- Release-Nummer verwendet werden, z.B. 1.0.0-1\n",
          "examples": [
            "1.0.0",
            "1.1.0-1",
            "1.2.0-1"
          ]
        },
        "type": {
          "type": "string",
          "deprecated": true,
          "enum": [
            "UMWELTNAVI",
            "UMWELTNAVI_SUB_GEOMETRY"
          ]
        },
        "metadata": {
          "type": "object",
          "properties": {
            "data_type": {
              "type": "string",
              "description": "Beschreibt den Typ des Metadatensatzes im Index. Jeder Eintrag beschreibt eine bestimmte Eigenschaft des DatenMetadatensatzessatzes. Die Eigenschaften z.B. im Portal verwendet, um eine bestimmte Darstellung des Metadatensatzes zu steuern.\n",
              "examples": [
                "UmweltNAVI Datensatz ['UMWELTNAVI']",
                "Opendata Datensatz  ['DCAT-AP', 'DCAT-AP.DE']",
                "Geometadatensatz ['GEOMETADATA']",
                "LVR Datensatz ['LVR']"
              ],
              "enum": [
                "DCAT-AP?",
                "DCAT-AP.DE?",
                "GEOMETADATA?",
                "LVR?",
                "UMWELTNAVI",
                "INGRID",
                "UVP"
              ]
            },
            "created": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "Das Datum der Erstellung des Metadatensatzes. ISO 8601 Format.\n",
              "examples": [
                "2026-04-22T12:00:00Z",
                "2026-04-22T12:00:00+01:00"
              ]
            },
            "modified": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "Das Datum der letzten Änderung des Metadatensatzes. ISO 8601 Format.\n",
              "examples": [
                "2026-04-22T12:00:00Z",
                "2026-04-22T12:00:00+01:00"
              ]
            },
            "issued": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "description": "Das Datum der ersten Veröffentlichung des Metadatensatzes. ISO 8601 Format.\n"
            },
            "partner": {
              "type": "string",
              "description": "Der Partner der Datenquelle als Kürzel. Siehe auch Codeliste 110.\n",
              "examples": [
                "bb",
                "st"
              ]
            },
            "provider": {
              "type": "string",
              "description": "Der Anbieter der Datenquelle als Kürzel. Siehe auch Codeliste 111.\n",
              "examples": [
                "ni_gll",
                "bw_mj"
              ]
            },
            "language": {
              "title": "language",
              "description": "Enthält die Sprache des Metadatensatzes. Hier wird die Codeliste 99999999 verwendet.",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "datasource": {
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Die ID der Datenquelle."
                },
                "name": {
                  "type": "string",
                  "description": "Der Name der Datenquelle."
                }
              }
            }
          },
          "required": [
            "data_type",
            "created",
            "modified"
          ]
        },
        "title": {
          "type": "string",
          "description": "Der Titel des Datensatzes.\n"
        },
        "description": {
          "description": "Die Beschreibung des Datensatzes.\n",
          "type": "string"
        },
        "spatials": {
          "type": "array",
          "description": "Dieser Bereich enthält Informationen über den Raumbezug.",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "Für UMWELTNAVI <oid>-<geometrie-id>"
              },
              "geometry": {
                "type": "object",
                "description": "Enthält die GeoJSON-Repräsentation, die für eine optimierte Suche benötigt wird. Siehe auch https://de.wikipedia.org/wiki/GeoJSON",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "Point",
                      "LineString",
                      "Polygon",
                      "MultiPoint",
                      "MultiLineString",
                      "MultiPolygon"
                    ]
                  },
                  "coordinates": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 4,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "description": "Koordinaten des Geometrieelements",
                    "examples": [
                      "..."
                    ]
                  }
                }
              },
              "bbox": {
                "type": "string",
                "description": "Umschließende BBOX der Geometrie"
              },
              "wkt": {
                "type": "string",
                "description": "Angabe eines Well-known text-Formats."
              },
              "toponym": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Textueller Raumbezug (wie Stadtnamen oder Flussnamen)",
                  "examples": [
                    "Frankfurt am Main",
                    "Hamburg"
                  ]
                },
                "minItems": 0
              },
              "administrative": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Land (z.B. ni, sh, rp)"
                    },
                    "minItems": 0
                  },
                  "regional_key": {
                    "type": "string"
                  }
                },
                "description": "Administrative Zuordnung"
              },
              "centroid": {
                "type": "string",
                "description": "Schwerpunkt der Geometrie",
                "deprecated": true
              },
              "inside_point": {
                "type": "string",
                "description": "Punkt innerhalb der Geometrie, der dem Schwerpunkt am nächsten liegt.",
                "deprecated": true
              },
              "geometry_points": {
                "type": "string",
                "description": "Geometrie als Punkte, wird für Distanz Berechnung verwendet (geo_distance Sortierung funktioniert nicht mit geo_shape)",
                "$comment": "Ehemaliges Indexfeld: location_points",
                "deprecated": true
              },
              "outline": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Outline für die Darstellung, ggf. reduzierte Geometrie"
                },
                "minItems": 0,
                "deprecated": true
              }
            }
          },
          "$comment": "Ehemaliges Indexfeld: layer"
        },
        "temporal": {
          "type": "object",
          "properties": {
            "data-temporal": {
              "type": "object",
              "properties": {
                "date_range": {
                  "type": "string"
                },
                "date_text": {
                  "type": "string",
                  "description": "Wird verwendet, wenn der Wert nicht in eine gültige DateRange Übertragbar ist",
                  "examples": [
                    "Sommer 2010"
                  ]
                },
                "date_type": {
                  "type": "string",
                  "enum": [
                    "created"
                  ]
                }
              },
              "if": {
                "not": {
                  "required": [
                    "date_range"
                  ]
                }
              },
              "then": {
                "required": [
                  "date_text"
                ]
              }
            }
          },
          "description": "Gültigkeitsdatumsbereich der beschriebenen Daten",
          "$comment": "Ehemaliges Indexfeld: object_date"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "description": "Keyword "
              },
              "id": {
                "type": "string",
                "description": "Eindeutiger Identifier des Keywords bezüglich der Quelle oder auch  URL-freundliche Form des Keywords (Slug)",
                "examples": [
                  "wk000680 "
                ]
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "term"
            ]
          },
          "minItems": 0
        },
        "fulltext": {
          "type": "string",
          "description": "Für Full Text Suche. Signifikanz von genauen Treffern kann hier geboostet werden. Entsprechende Felder sollten mit copy_to-Operation in Elasticsearch kopiert werden.",
          "$comment": "Früher content-Feld"
        },
        "sort_uuid": {
          "description": "Sortier-UUID für die Sortierung von Datensätzen, die bei einer leeren Suche durchmischt angezeigt werden sollen.",
          "type": "string"
        },
        "language": {
          "type": "string",
          "description": "Welches Format hat die Sprache, wo wird es verwendet."
        },
        "format": {
          "description": "Wo kommt das her???",
          "type": "string"
        },
        "contacts": {
          "type": "array",
          "items": {
            "properties": {
              "role": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "communications": {
                "type": "array",
                "items": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "email",
                        "phone",
                        "fax",
                        "website",
                        "social",
                        "other"
                      ]
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "street": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "pocode": {
                "type": "string"
              },
              "pobox": {
                "type": "string"
              },
              "locality": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "administrative_area": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "schema_version",
        "metadata",
        "title",
        "fulltext"
      ]
    },
    {
      "type": "object",
      "title": "LVR",
      "properties": {
        "lvr": {
          "type": "object",
          "properties": {
            "relations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "score": {
                    "type": "string"
                  }
                }
              }
            },
            "media": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "thumbnail": {
                    "type": "string",
                    "description": "URL zu einem Thumbnail-Bild, falls vorhanden"
                  },
                  "dimensions": {
                    "type": "object",
                    "properties": {
                      "width": {
                        "type": "integer",
                        "description": "Breite in Pixeln",
                        "examples": [
                          "1600"
                        ],
                        "enum": [
                          ">= 1"
                        ]
                      },
                      "height": {
                        "type": "integer",
                        "description": "Höhe in Pixeln",
                        "examples": [
                          "900"
                        ],
                        "enum": [
                          ">= 1"
                        ]
                      }
                    },
                    "required": [
                      "width",
                      "height"
                    ],
                    "description": "Dimensionen des Bildes, falls type = \"image\""
                  }
                }
              }
            },
            "persons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "Ermitteln, welche Werte in den einzelnen Quellen auftreten können, und dann normalisieren",
                    "examples": [
                      "personal, corporate"
                    ]
                  },
                  "role": {
                    "type": "string",
                    "description": "Ermitteln, welche Werte in den einzelnen Quellen auftreten können, und dann normalisieren",
                    "examples": [
                      "Redactor"
                    ]
                  },
                  "name": {
                    "type": "object",
                    "properties": {
                      "first": {
                        "type": "string",
                        "description": "In den Daten können mehrere Vornamen auftreten; Vorschlag: .join(' ')",
                        "examples": [
                          "Ludger J."
                        ]
                      },
                      "last": {
                        "type": "string",
                        "description": "In den Daten können mehrere Nachnamen auftreten; Vorschlag: .join(' ')",
                        "examples": [
                          "Sutthoff"
                        ]
                      },
                      "display": {
                        "type": "string",
                        "examples": [
                          "Sutthoff, Ludger J."
                        ]
                      }
                    }
                  }
                }
              }
            },
            "licenses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "examples": [
                      "dl-by-de/2.0"
                    ]
                  },
                  "url": {
                    "type": "string",
                    "examples": [
                      "https://www.govdata.de/dl-de/by-2-0"
                    ]
                  },
                  "holder": {
                    "type": "string",
                    "description": "Rechteinhaber",
                    "examples": [
                      "LVR-Institut für Landeskunde und Regionalgeschichte"
                    ]
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "genres": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Normalisieren; z.B. buch, ort, rede, artefakt, ...",
                "examples": [
                  "book"
                ]
              }
            },
            "vector": {
              "type": "object"
            },
            "original_id": {
              "type": "string"
            },
            "source": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "display_url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ]
}